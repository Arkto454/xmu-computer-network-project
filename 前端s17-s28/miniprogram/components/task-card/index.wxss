@import "../../styles/tokens.wxss";
:host { display: block; margin-top: var(--space-medium); }
.task-card { box-sizing: border-box; padding: 28rpx; color: var(--color-text); background: var(--color-surface); border: 1rpx solid var(--color-border); border-top: 4rpx solid var(--color-primary); border-radius: 8rpx; font-size: var(--text-body); line-height: 1.6; }
.task-card--pressed { background: #edf4ed; }
.card-heading { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 16rpx 24rpx; }
.heading-main { flex: 1; min-width: 180rpx; }
.task-title { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; overflow-wrap: anywhere; font-size: 34rpx; line-height: 1.45; font-weight: 600; }
.type { display: block; margin-top: 8rpx; font-size: var(--text-small); color: var(--color-muted); }
.reward { max-width: 100%; text-align: right; }
.amount { display: block; font-size: 40rpx; font-weight: 700; color: var(--color-primary); overflow-wrap: anywhere; }
.reward-label { display: block; font-size: var(--text-small); color: var(--color-muted); }
.route { margin-top: 24rpx; }
.route-stop { display: flex; align-items: flex-start; margin-top: 16rpx; }
.stop-label { flex-shrink: 0; box-sizing: border-box; width: 44rpx; height: 44rpx; line-height: 42rpx; margin-right: 16rpx; border: 1rpx solid var(--color-primary); border-radius: 50%; color: var(--color-primary); text-align: center; font-size: 26rpx; }
.stop-label--end { background: var(--color-primary); color: #fff; }
.location { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.card-footer { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 28rpx; padding-top: 20rpx; border-top: 1rpx solid var(--color-border); }
.card-times { display: flex; flex: 1; flex-wrap: wrap; gap: 4rpx 18rpx; min-width: 160rpx; }
.deadline, .published { min-width: 0; color: var(--color-muted); font-size: var(--text-small); overflow-wrap: anywhere; }
@media (max-width: 340px) { .heading-main { flex-basis: 100%; } .reward { text-align: left; } }
