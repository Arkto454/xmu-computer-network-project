@import "../../styles/tokens.wxss";
:host { display: block; margin-top: 32rpx; }
.state-panel { box-sizing: border-box; padding: 40rpx 28rpx; background: var(--color-surface); border: 1rpx solid var(--color-border); border-radius: 10rpx; text-align: left; color: var(--color-text); line-height: 1.6; }
.marker { display: block; width: 52rpx; height: 52rpx; margin-bottom: 20rpx; border: 1rpx solid var(--color-border); border-radius: 50%; text-align: center; font-size: 32rpx; color: var(--color-muted); }
.state-title { display: block; font-size: 34rpx; font-weight: 600; overflow-wrap: anywhere; }
.state-description { display: block; margin-top: 12rpx; font-size: var(--text-small); color: var(--color-muted); overflow-wrap: anywhere; }
.state-panel--error { border-left: 6rpx solid var(--color-danger); }
.state-panel--error .state-title, .state-panel--error .marker { color: var(--color-danger); }
.state-panel--unknown { border-left: 6rpx solid var(--color-warning); }
.state-panel .state-action { box-sizing: border-box; width: 100%; min-height: 88rpx; margin: 28rpx 0 0; padding: 20rpx 24rpx; border-radius: 12rpx; background: var(--color-surface); color: var(--color-primary); font-size: 32rpx; line-height: 1.5; }
.state-action::after { border: 1rpx solid var(--color-primary); border-radius: 12rpx; }
.state-panel .state-action--busy { color: var(--color-muted); background: #e5e9e2; }
