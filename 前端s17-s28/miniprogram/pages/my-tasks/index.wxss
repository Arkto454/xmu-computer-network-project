.relationship-tabs { display: flex; margin-top: 32rpx; border: 1rpx solid #b9c6bc; border-radius: 10rpx; overflow: hidden; }
.relation { flex: 1; min-width: 0; border-radius: 0; font-size: 30rpx; color: #40574e; background: #fff; }
.relation::after { border: 0; }
.relation + .relation { border-left: 1rpx solid #b9c6bc; }
.relation.selected { background: #17634f; color: #fff; font-weight: 650; }
.list-controls { display: flex; align-items: center; gap: 20rpx; margin-top: 24rpx; }
.status-picker { flex: 1; min-width: 0; }
.status-value { padding: 16rpx 22rpx; border: 1rpx solid #b9c6bc; border-radius: 8rpx; background: #fff; font-size: 28rpx; color: #17332d; }
.refresh { width: auto; flex: 0 0 auto; min-height: 76rpx; padding: 14rpx 24rpx; font-size: 28rpx; color: #17634f; }
.task-list { padding-top: 8rpx; }
.more { margin-top: 24rpx; color: #17634f; }
.end-note { display: block; margin-top: 28rpx; text-align: center; color: #576c63; font-size: 26rpx; }
.preview { margin-top: 40rpx; }
.preview-toggle { width: auto; margin: 0 auto; padding: 14rpx 22rpx; min-height: 68rpx; font-size: 26rpx; color: #576c63; }
.preview-panel { margin-top: 16rpx; padding: 20rpx; border: 1rpx dashed #b9c6bc; }
.account-grid { display: flex; flex-wrap: wrap; gap: 12rpx; margin: 20rpx 0; }
.account { width: calc(50% - 6rpx); min-height: 72rpx; padding: 14rpx 12rpx; font-size: 26rpx; }
.account-selected { color: #fff; background: #17634f; }
