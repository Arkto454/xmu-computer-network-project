<import src="../../templates/mode.wxml" />
<view class="page"><template is="mode" data="{{modeLabel: modeLabel}}" />
<text class="title">核对交付</text><text class="muted">任务编号：{{taskId || '未提供'}}</text>
<view wx:if="{{task}}" class="section"><text class="section-title">{{task.title}}</text><text class="detail-line">{{task.status}}</text><text class="detail-line">取：{{task.pickupLocation}}</text><text class="detail-line">送：{{task.deliveryLocation}}</text></view>
<view wx:if="{{pageState === 'auth'}}" class="section"><text>{{message}}</text><button class="primary" bindtap="go" data-page="login">微信登录</button></view>
<view wx:elif="{{pageState === 'mock'}}" class="section"><text>{{message}}</text></view>
<page-state wx:elif="{{pageState}}" state="{{pageState}}" description="{{message}}" busy="{{busy}}" bind:action="reload" />
<view wx:else class="section">
  <text role="status">{{message}}</text><text wx:if="{{completed}}" class="complete-title">任务已完成</text>
  <text wx:if="{{settlementText}}" class="hint">本次模拟结算：¥{{settlementText}}，以服务端记录为准，无真实付款。</text>
  <button wx:if="{{canScan}}" class="primary scan-button" disabled="{{busy}}" bindtap="startScan">{{review ? '重新扫码核对' : '扫描接单者交付码'}}</button>
  <view wx:if="{{review}}" class="review-panel">
    <text class="section-title">请核对本次交付</text><text class="detail-line">{{review.title}}</text><text class="detail-line">任务编号：{{taskId}}</text><text class="detail-line">模拟奖励：¥{{review.rewardText}}</text>
    <text class="hint">交付码剩余 {{remainingText}}，有效性以服务端为准。保持设备时间准确。</text><text class="hint">扫码核对不会自动完成任务。确认前请实际收到物品。</text>
    <button class="primary" disabled="{{busy || !canConfirm}}" loading="{{busy}}" bindtap="confirmTask">已收到物品，确认完成</button>
  </view>
</view>
<view wx:if="{{notice || resultUnknown}}" class="section"><text role="status">{{notice || '确认结果仍待查询，请勿重复提交。'}}</text></view>
<view class="actions"><button disabled="{{busy}}" loading="{{busy}}" bindtap="reload">查询任务最新状态</button><button bindtap="back">返回上一页</button></view>
</view>
