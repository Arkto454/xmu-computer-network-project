.earnings-total { display: block; margin-top: 12rpx; color: #17634f; font-size: 56rpx; font-weight: 650; }
.earnings-list { margin-top: 32rpx; }
.page .earning-row { display: flex; justify-content: space-between; gap: 20rpx; width: 100%; max-width: 100%; box-sizing: border-box; padding: 24rpx; margin-top: 16rpx; text-align: left; background: #fff; }
.earning-main { flex: 1; min-width: 0; }
.earning-title { display: block; font-size: 30rpx; line-height: 1.5; overflow-wrap: anywhere; }
.earning-value { flex-shrink: 0; max-width: 45%; text-align: right; overflow-wrap: anywhere; }
.earning-amount { display: block; color: #17634f; font-size: 32rpx; font-weight: 650; }
.end-note { display: block; margin-top: 24rpx; text-align: center; font-size: 26rpx; color: #576c63; }
