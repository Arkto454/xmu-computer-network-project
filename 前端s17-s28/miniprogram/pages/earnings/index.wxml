<import src="../../templates/mode.wxml" />
<view class="page"><template is="mode" data="{{modeLabel: modeLabel}}" />
<text class="title">模拟收益</text><view class="note">仅展示已结算的模拟奖励，不涉及真实支付。</view>
<view wx:if="{{total !== null}}" class="section earnings-summary">
  <text class="muted">累计模拟结算</text><text class="earnings-total">¥{{totalAmountText}}</text><text class="hint">已结算 {{total}} 条任务，以{{isMock ? '演示数据' : '服务端记录'}}为准。</text>
</view>
<button wx:if="{{session.authenticated}}" disabled="{{loading}}" loading="{{loading}}" bindtap="refresh">刷新模拟收益</button>
<text wx:if="{{notice}}" class="hint" role="status">{{notice}}</text>
<page-state wx:if="{{pageState}}" state="{{pageState}}" title="{{pageState === 'empty' ? '暂无已结算记录' : ''}}" description="{{pageState === 'empty' ? '已完成并由服务端结算的承接任务会显示在这里。待确认任务不计入。' : pageState === 'login' ? '登录后查看当前账号的模拟结算汇总和明细。' : ''}}" busy="{{loading}}" bind:action="stateAction" />
<view wx:if="{{items.length}}" class="earnings-list">
  <text class="section-title">已结算任务</text>
  <button wx:for="{{items}}" wx:key="taskId" class="earning-row" data-task-id="{{item.taskId}}" bindtap="openTask">
    <view class="earning-main"><text class="earning-title">{{item.title}}</text><text class="hint">任务 {{item.taskId}}</text><text class="hint">结算时间：{{item.settledText}}</text></view>
    <view class="earning-value"><text class="earning-amount">¥{{item.amountText}}</text><text class="hint">查看任务 ›</text></view>
  </button>
  <page-state wx:if="{{moreError && !stale}}" state="error" title="这一页未能加载" description="已保留前面的明细，可以重试加载更多。" action-text="重试加载更多" busy="{{loadingMore}}" bind:action="loadMore" />
  <button wx:if="{{hasMore && !stale && !moreError}}" disabled="{{loading || loadingMore}}" loading="{{loadingMore}}" bindtap="loadMore">{{loadingMore ? '正在加载' : '加载更多'}}</button>
  <text wx:if="{{!hasMore && !stale && !loading && !loadingMore && !moreError}}" class="end-note">已显示全部已结算记录</text>
</view>
<view class="actions"><button wx:if="{{refreshError || stale && !loading && items.length}}" bindtap="refresh">重新刷新汇总与明细</button><button bindtap="back">返回上一页</button></view>
</view>
