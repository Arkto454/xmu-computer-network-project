@baseUrl = http://localhost:8080
@adminUsername = admin
@adminPassword = REPLACE_WITH_LOCAL_ADMIN_PASSWORD
@accessToken = REPLACE_WITH_LOGIN_ACCESS_TOKEN
@wechatCode = REPLACE_WITH_REAL_WX_LOGIN_CODE
@studentAccessToken = REPLACE_WITH_STUDENT_ACCESS_TOKEN
@taskId = REPLACE_WITH_CREATED_TASK_ID
@taskDeadline = 2099-12-31T10:00:00Z

### 应用与数据库健康检查
GET {{baseUrl}}/api/health

### 管理员登录，在本机替换密码占位符
POST {{baseUrl}}/api/admin/auth/login
Content-Type: application/json

{
  "username": "{{adminUsername}}",
  "password": "{{adminPassword}}"
}

### 将登录返回的 accessToken 填入顶部占位符
GET {{baseUrl}}/api/admin/me
Authorization: Bearer {{accessToken}}

### 学生微信登录：需要配置AppID/AppSecret；未配置时预期503
POST {{baseUrl}}/api/student/auth/wechat
Content-Type: application/json

{
  "code": "{{wechatCode}}"
}

### 学生身份查询：使用学生登录返回的凭据
GET {{baseUrl}}/api/student/me
Authorization: Bearer {{studentAccessToken}}

### 不带凭据，预期 HTTP 401
GET {{baseUrl}}/api/admin/me

### 发布任务：需要真实学生凭据；字段内容仅为示例
POST {{baseUrl}}/api/student/tasks
Authorization: Bearer {{studentAccessToken}}
Content-Type: application/json

{
  "title": "帮取快递",
  "type": "EXPRESS",
  "pickupLocation": "校园快递站东门",
  "deliveryLocation": "宿舍楼一楼门口",
  "deadlineAt": "{{taskDeadline}}",
  "rewardAmount": 3.50,
  "description": "两个小包裹",
  "publisherPhone": "13800000000",
  "publisherWechat": "demo_wechat_contact",
  "privateInstructions": "DEMO-PICKUP-CODE"
}

### 大厅仅返回公开摘要
GET {{baseUrl}}/api/student/tasks?page=1&size=20&type=EXPRESS
Authorization: Bearer {{studentAccessToken}}

### 用发布者凭据查看完整信息；换另一学生凭据后不返回privateInfo
GET {{baseUrl}}/api/student/tasks/{{taskId}}
Authorization: Bearer {{studentAccessToken}}
