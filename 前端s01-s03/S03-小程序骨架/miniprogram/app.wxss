page { background: #f4f5ef; color: #17332d; font-family: -apple-system, BlinkMacSystemFont, "Microsoft YaHei", sans-serif; font-size: 30rpx; line-height: 1.6; }
view, text, input, textarea, button { box-sizing: border-box; }
button { margin: 0; font-size: 30rpx; line-height: 1.5; padding: 22rpx 28rpx; border-radius: 12rpx; color: #17332d; background: #fff; }
button::after { border-color: #d8dfd8; border-radius: 12rpx; }
button[disabled] { color: #576c63; background: #e5e9e2; }
.page { padding: 0 32rpx 40rpx; padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); }
.mode-banner { margin: 0 -32rpx 32rpx; padding: 12rpx 32rpx; font-size: 24rpx; color: #8a4a17; background: #fff8e8; border-bottom: 1rpx solid #dfded0; }
.title { display: block; font-size: 40rpx; line-height: 1.4; font-weight: 650; margin-bottom: 12rpx; }
.subtitle { display: block; font-size: 32rpx; font-weight: 650; }
.muted { color: #576c63; }
.small { font-size: 26rpx; }
.hint { display: block; margin-top: 12rpx; font-size: 26rpx; color: #576c63; }
.section { margin-top: 32rpx; padding: 28rpx; background: #fff; border: 1rpx solid #d8dfd8; border-radius: 10rpx; }
.section-title { display: block; margin-bottom: 20rpx; font-size: 32rpx; font-weight: 650; }
.row { display: flex; align-items: flex-start; justify-content: space-between; gap: 24rpx; }
.row-main { flex: 1; min-width: 0; }
.primary { background: #17634f; color: #fff; }
.primary::after { border-color: #17634f; }
.space { margin-top: 24rpx; }
.actions { display: flex; flex-direction: column; gap: 20rpx; margin-top: 32rpx; }
.task { margin-top: 24rpx; padding: 28rpx; background: #fff; border-top: 4rpx solid #17634f; border-bottom: 1rpx solid #d8dfd8; border-radius: 6rpx; }
.task-title { display: block; font-size: 32rpx; font-weight: 650; overflow-wrap: break-word; }
.amount { display: block; color: #17634f; font-size: 40rpx; font-weight: 700; white-space: nowrap; }
.amount-label { display: block; font-size: 22rpx; color: #576c63; text-align: right; }
.route { margin-top: 24rpx; }
.route-stop { display: flex; align-items: flex-start; margin-top: 12rpx; }
.stop-label { flex-shrink: 0; width: 40rpx; height: 40rpx; line-height: 38rpx; text-align: center; margin-right: 16rpx; border: 1rpx solid #17634f; border-radius: 50%; color: #17634f; font-size: 24rpx; }
.stop-end { background: #17634f; color: #fff; }
.meta { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12rpx; margin-top: 24rpx; font-size: 24rpx; color: #576c63; }
.field { margin-top: 24rpx; }
.field-label { display: block; margin-bottom: 10rpx; font-size: 28rpx; font-weight: 550; }
.input, .textarea, .picker-value { display: block; width: 100%; padding: 22rpx; background: #fff; border: 1rpx solid #b9c6bc; border-radius: 10rpx; font-size: 30rpx; }
.input { height: 92rpx; }
.textarea { min-height: 180rpx; }
.empty { padding: 40rpx 0; }
.note { padding: 24rpx; border-left: 5rpx solid #17634f; background: #eaf0e7; font-size: 28rpx; }
.badge { display: inline-block; padding: 4rpx 14rpx; border: 1rpx solid #d8dfd8; border-radius: 6rpx; font-size: 26rpx; background: #fff; }
.menu button { margin-top: 20rpx; text-align: left; }
.code-placeholder { display: flex; align-items: center; justify-content: center; height: 360rpx; margin-top: 32rpx; padding: 32rpx; background: #fff; border: 2rpx dashed #8a9e91; text-align: center; color: #576c63; }
